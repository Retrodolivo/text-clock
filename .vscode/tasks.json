{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "openocd",
      "type": "shell",
      "isBackground": true,
      "command": "openocd",
      "args": [
        "-s", "share/openocd/scripts",
        "-f", "interface/jlink.cfg",
        "-f", "target/esp32.cfg",
        "-c", "adapter speed 10000",
        "-c", "set ESP_RTOS none"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Info : Listening on port 3333 for gdb connections",
          "endsPattern": "Info : Listening on port 3333 for gdb connections"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "kill-openocd",
      "type": "shell",
      "command": "pkill",
      "args": ["-f", "openocd"]
    }
  ]
}